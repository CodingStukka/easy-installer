#: src/easy_installer/__main__.py:86
msgid "The window toolkit it needs (GTK 4 and libadwaita) is not installed."
msgstr "Die dafür nötigen Fenster-Bibliotheken (GTK 4 und libadwaita) sind nicht installiert."

#: src/easy_installer/__main__.py:89
#, python-brace-format
msgid "The installed libadwaita {found} is too old; version {needed} or newer is needed."
msgstr "Das installierte libadwaita {found} ist zu alt; Version {needed} oder neuer wird benötigt."

#: src/easy_installer/__main__.py:93
msgid "No graphical desktop was found."
msgstr "Es wurde keine grafische Oberfläche gefunden."

#: src/easy_installer/__main__.py:109
#, python-brace-format
msgid "Easy Installer cannot open its window: {problem}"
msgstr "Easy Installer kann sein Fenster nicht öffnen: {problem}"

#: src/easy_installer/__main__.py:110
msgid "You can still use Easy Installer in the terminal, for example:"
msgstr "Du kannst Easy Installer trotzdem im Terminal verwenden, zum Beispiel:"

#: src/easy_installer/__main__.py:125
msgid "Its window could not be loaded."
msgstr "Das Fenster konnte nicht geladen werden."

#: src/easy_installer/cli.py:119
msgid "usage: "
msgstr "Aufruf: "

#: src/easy_installer/cli.py:120
msgid "positional arguments"
msgstr "Argumente"

#: src/easy_installer/cli.py:121
msgid "options"
msgstr "Optionen"

#: src/easy_installer/cli.py:122
msgid "show this help message and exit"
msgstr "diese Hilfe anzeigen und beenden"

#: src/easy_installer/cli.py:123
#, python-format
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s: Fehler: %(message)s\n"

#: src/easy_installer/cli.py:124
#, python-format
msgid "the following arguments are required: %s"
msgstr "die folgenden Argumente fehlen: %s"

#: src/easy_installer/cli.py:125
#, python-format
msgid "invalid choice: %(value)r (choose from %(choices)s)"
msgstr "ungültige Auswahl: %(value)r (möglich sind %(choices)s)"

#: src/easy_installer/cli.py:126
#, python-format
msgid "unrecognized arguments: %s"
msgstr "unbekannte Argumente: %s"

#: src/easy_installer/cli.py:127
msgid "expected one argument"
msgstr "ein Argument erwartet"

#: src/easy_installer/cli.py:128
#, python-format
msgid "argument %(argument_name)s: %(message)s"
msgstr "Argument %(argument_name)s: %(message)s"

#: src/easy_installer/cli.py:129
#, python-format
msgid "not allowed with argument %s"
msgstr "nicht zusammen mit Argument %s erlaubt"

#: src/easy_installer/cli.py:130
#, python-format
msgid "ambiguous option: %(option)s could match %(matches)s"
msgstr "mehrdeutige Option: %(option)s könnte %(matches)s bedeuten"

#: src/easy_installer/cli.py:257 src/easy_installer/core/updates.py:177
#, python-brace-format
msgid "{size} MB"
msgstr "{size} MB"

#. Translators: the short answer for "yes" accepted at [Y/n] questions (lower case).
#: src/easy_installer/cli.py:266 src/easy_installer/cli.py:458
#: src/easy_installer/cli.py:1386
msgid "yes"
msgstr "ja"

#. Translators: the short answer for "no" accepted at [Y/n] questions (lower case).
#: src/easy_installer/cli.py:266 src/easy_installer/cli.py:463
#: src/easy_installer/cli.py:1358
msgid "no"
msgstr "nein"

#: src/easy_installer/cli.py:270 src/easy_installer/cli.py:1427
msgid "unknown"
msgstr "unbekannt"

#: src/easy_installer/cli.py:274 src/easy_installer/gui/app_row.py:27
#: src/easy_installer/gui/install_dialog.py:338
msgid "Only for me"
msgstr "Nur für mich"

#: src/easy_installer/cli.py:274 src/easy_installer/gui/app_row.py:27
#: src/easy_installer/gui/install_dialog.py:341
msgid "Everyone on this computer"
msgstr "Alle auf diesem Computer"

#: src/easy_installer/cli.py:278
msgid "Only me"
msgstr "Nur ich"

#: src/easy_installer/cli.py:278
msgid "Everyone"
msgstr "Alle"

#: src/easy_installer/cli.py:332
msgid "signed by the same maker as the installed version"
msgstr "vom selben Hersteller signiert wie die installierte Version"

#: src/easy_installer/cli.py:334
#, python-brace-format
msgid "signed with a key named “{signer}”"
msgstr "mit einem Schlüssel namens „{signer}“ signiert"

#: src/easy_installer/cli.py:335
msgid "signed with a key that has no name"
msgstr "mit einem Schlüssel ohne Namen signiert"

#: src/easy_installer/cli.py:337
msgid "the signature does not match"
msgstr "die Signatur passt nicht"

#: src/easy_installer/cli.py:339
msgid "signed, but the signature could not be checked"
msgstr "signiert, aber die Signatur konnte nicht geprüft werden"

#: src/easy_installer/cli.py:342
#, python-brace-format
msgid "key {fingerprint}"
msgstr "Schlüssel {fingerprint}"

#: src/easy_installer/cli.py:355
msgid "settings"
msgstr "Einstellungen"

#: src/easy_installer/cli.py:356
msgid "app data"
msgstr "App-Daten"

#: src/easy_installer/cli.py:357
msgid "temporary files"
msgstr "temporäre Dateien"

#: src/easy_installer/cli.py:358
msgid "app state"
msgstr "App-Zustand"

#: src/easy_installer/cli.py:359
msgid "settings and data"
msgstr "Einstellungen und Daten"

#. Translators: the short answer for "yes" accepted at [Y/n] questions (lower case).
#: src/easy_installer/cli.py:458
msgid "y"
msgstr "j"

#. Translators: the short answer for "no" accepted at [Y/n] questions (lower case).
#: src/easy_installer/cli.py:463
msgid "n"
msgstr "n"

#: src/easy_installer/cli.py:474
msgid "No answer was given. Add -y to skip the question."
msgstr "Es wurde keine Antwort gegeben. Mit -y wird die Frage übersprungen."

#: src/easy_installer/cli.py:494
msgid "Please answer y (yes) or n (no)."
msgstr "Bitte antworte mit j (ja) oder n (nein)."

#: src/easy_installer/cli.py:509
#, python-brace-format
msgid "Please type one of: {choices}"
msgstr "Bitte gib eins davon ein: {choices}"

#: src/easy_installer/cli.py:528
#, python-brace-format
msgid "the ID of the app (see: {command})"
msgstr "die ID der App (siehe: {command})"

#: src/easy_installer/cli.py:540 src/easy_installer/cli.py:557
msgid "show more details, for example the technical cause of an error (use -vv for even more)"
msgstr "mehr Details anzeigen, zum Beispiel die technische Ursache eines Fehlers (-vv für noch mehr)"

#: src/easy_installer/cli.py:545
#, python-brace-format
msgid "Install AppImage apps so they appear in your app menu, update them, and remove them again. Start {prog} without a command to open its window."
msgstr "AppImage-Apps so installieren, dass sie in deinem App-Menü erscheinen, sie aktualisieren und wieder entfernen. Starte {prog} ohne Befehl, um das Fenster zu öffnen."

#: src/easy_installer/cli.py:548
#, python-brace-format
msgid ""
"Examples:\n"
"  {prog} install ~/Downloads/MyApp.AppImage\n"
"  {prog} list\n"
"  {prog} uninstall myapp"
msgstr ""
"Beispiele:\n"
"  {prog} install ~/Downloads/MeineApp.AppImage\n"
"  {prog} list\n"
"  {prog} uninstall meineapp"

#: src/easy_installer/cli.py:555
msgid "show the version of Easy Installer and exit"
msgstr "die Version von Easy Installer anzeigen und beenden"

#: src/easy_installer/cli.py:559
msgid "COMMAND"
msgstr "BEFEHL"

#: src/easy_installer/cli.py:559
msgid "commands"
msgstr "Befehle"

#: src/easy_installer/cli.py:565
msgid "show what is inside an AppImage or app archive (without installing it)"
msgstr "anzeigen, was in einem AppImage oder App-Archiv steckt (ohne es zu installieren)"

#: src/easy_installer/cli.py:566
msgid "Show the name, version, icon and other details of an AppImage. The app is not started."
msgstr "Name, Version, Symbol und weitere Details eines AppImages anzeigen. Die App wird dabei nicht gestartet."

#: src/easy_installer/cli.py:567
msgid "App archives (.zip, .tar.gz, …) can be looked at, too."
msgstr "App-Archive (.zip, .tar.gz, …) können auch angesehen werden."

#: src/easy_installer/cli.py:569
msgid "the .AppImage file to look at"
msgstr "die .AppImage-Datei, die angezeigt werden soll"

#: src/easy_installer/cli.py:570 src/easy_installer/cli.py:575
#: src/easy_installer/cli.py:601 src/easy_installer/cli.py:642
#: src/easy_installer/cli.py:701 src/easy_installer/cli.py:739
msgid "print machine-readable JSON"
msgstr "maschinenlesbares JSON ausgeben"

#: src/easy_installer/cli.py:573
msgid "list the installed apps"
msgstr "die installierten Apps auflisten"

#: src/easy_installer/cli.py:574
msgid "List the apps installed with Easy Installer."
msgstr "Die mit Easy Installer installierten Apps auflisten."

#: src/easy_installer/cli.py:576 src/easy_installer/cli.py:698
msgid "only apps installed just for you"
msgstr "nur Apps, die nur für dich installiert sind"

#: src/easy_installer/cli.py:577 src/easy_installer/cli.py:699
msgid "only apps installed for everyone on this computer"
msgstr "nur Apps, die für alle auf diesem Computer installiert sind"

#: src/easy_installer/cli.py:584
msgid "go back to the version of an app you had before its last update"
msgstr "zu der Version einer App zurückkehren, die du vor ihrem letzten Update hattest"

#: src/easy_installer/cli.py:585
msgid "Go back to the version of an app that was installed before its last update. The version you have now is kept, so you can switch back."
msgstr "Kehre zu der Version einer App zurück, die vor ihrem letzten Update installiert war. Die Version, die du jetzt hast, wird aufbewahrt, damit du wieder zurückwechseln kannst."

#: src/easy_installer/cli.py:588 src/easy_installer/cli.py:599
#: src/easy_installer/cli.py:627
msgid "the copy installed just for you"
msgstr "die nur für dich installierte Kopie"

#: src/easy_installer/cli.py:589 src/easy_installer/cli.py:628
msgid "the copy installed for everyone (asks for your password)"
msgstr "die für alle installierte Kopie (fragt nach deinem Passwort)"

#: src/easy_installer/cli.py:590
msgid "do not ask before going back"
msgstr "vor dem Zurückkehren nicht nachfragen"

#: src/easy_installer/cli.py:594
msgid "show everything known about an installed app"
msgstr "alles anzeigen, was über eine installierte App bekannt ist"

#: src/easy_installer/cli.py:595
msgid "Show everything Easy Installer knows about an installed app: version, size, where its updates come from, where it was downloaded from, its signature, the kept previous version and its settings and data folders."
msgstr "Zeigt alles, was Easy Installer über eine installierte App weiß: Version, Größe, woher ihre Updates kommen, wo sie heruntergeladen wurde, ihre Signatur, die aufbewahrte vorherige Version und ihre Ordner für Einstellungen und Daten."

#: src/easy_installer/cli.py:600
msgid "the copy installed for everyone on this computer"
msgstr "die für alle auf diesem Computer installierte Kopie"

#: src/easy_installer/cli.py:605
msgid "remove an installed app"
msgstr "eine installierte App entfernen"

#: src/easy_installer/cli.py:606
msgid "Remove an installed app, its menu entry and its icon. Your personal files and settings are kept."
msgstr "Eine installierte App samt Menüeintrag und Symbol entfernen. Deine persönlichen Dateien und Einstellungen bleiben erhalten."

#: src/easy_installer/cli.py:611
msgid "remove the copy installed for everyone (asks for your password)"
msgstr "die für alle installierte Kopie entfernen (fragt nach deinem Passwort)"

#: src/easy_installer/cli.py:612
msgid "remove the copy installed just for you"
msgstr "die nur für dich installierte Kopie entfernen"

#: src/easy_installer/cli.py:614
msgid "remove an app installed just for you without the administrator password; the special permission it needed stays on this computer"
msgstr "eine nur für dich installierte App ohne das Administratorpasswort entfernen; die besondere Berechtigung, die sie brauchte, bleibt auf diesem Computer"

#: src/easy_installer/cli.py:617
msgid "also move the app's settings and data folders to the trash (they are listed first)"
msgstr "auch die Ordner mit den Einstellungen und Daten der App in den Papierkorb verschieben (sie werden vorher aufgelistet)"

#: src/easy_installer/cli.py:619
msgid "do not ask before uninstalling"
msgstr "vor dem Deinstallieren nicht nachfragen"

#: src/easy_installer/cli.py:623
msgid "make the menu entry and icon of an installed app again"
msgstr "Menüeintrag und Symbol einer installierten App neu erstellen"

#: src/easy_installer/cli.py:624
msgid "Make the menu entry, the icon and the saved information of an installed app again from the app itself. The app stays where it is."
msgstr "Erstellt den Menüeintrag, das Symbol und die gespeicherten Informationen einer installierten App neu aus der App selbst. Die App bleibt, wo sie ist."

#: src/easy_installer/cli.py:631
msgid "start an installed app"
msgstr "eine installierte App starten"

#: src/easy_installer/cli.py:632
msgid "Start an installed app, just like its menu entry does."
msgstr "Eine installierte App starten, genau wie über ihren Menüeintrag."

#: src/easy_installer/cli.py:639
msgid "check whether this computer is ready for AppImages"
msgstr "prüfen, ob dieser Computer für AppImages bereit ist"

#: src/easy_installer/cli.py:640
msgid "Check the parts of this computer that AppImages need, with tips on how to fix what is missing."
msgstr "Prüfen, ob dieser Computer alles hat, was AppImages brauchen – mit Tipps, wie du Fehlendes nachrüstest."

#: src/easy_installer/cli.py:649
msgid "install an AppImage or app archive so it appears in your app menu"
msgstr "ein AppImage oder App-Archiv installieren, damit die App in deinem App-Menü erscheint"

#: src/easy_installer/cli.py:650
msgid "Install an AppImage: the file is moved to your Applications folder and the app gets a menu entry with its own icon."
msgstr "Ein AppImage installieren: Die Datei wird in deinen Ordner „Applications“ verschoben und die App bekommt einen Menüeintrag mit eigenem Symbol."

#: src/easy_installer/cli.py:652
msgid "An app that comes as an archive (.zip, .tar.gz, …) is unpacked into its own folder there; the archive itself is kept."
msgstr "Eine App, die als Archiv kommt (.zip, .tar.gz, …), wird dort in einen eigenen Ordner entpackt; das Archiv selbst bleibt erhalten."

#: src/easy_installer/cli.py:655
msgid "the .AppImage file or app archive (.zip, .tar.gz, …) to install"
msgstr "die zu installierende .AppImage-Datei oder das App-Archiv (.zip, .tar.gz, …)"

#: src/easy_installer/cli.py:657
msgid "install for everyone on this computer (asks for your password)"
msgstr "für alle auf diesem Computer installieren (fragt nach deinem Passwort)"

#: src/easy_installer/cli.py:659
msgid "keep the original file where it is and install a copy"
msgstr "die Originaldatei an ihrem Ort lassen und eine Kopie installieren"

#: src/easy_installer/cli.py:661
msgid "if another version of the app is installed, keep it and install this one next to it instead of replacing it"
msgstr "wenn eine andere Version der App installiert ist: sie behalten und diese daneben installieren, statt sie zu ersetzen"

#: src/easy_installer/cli.py:664
msgid "do not keep the version that is replaced (normally it is kept for a while, so you can go back to it)"
msgstr "die ersetzte Version nicht aufbewahren (normalerweise wird sie eine Weile aufbewahrt, damit du zu ihr zurückkehren kannst)"

#: src/easy_installer/cli.py:667
msgid "app archives only: the program in the archive that starts the app, for example bin/myapp"
msgstr "nur für App-Archive: das Programm im Archiv, das die App startet, zum Beispiel bin/myapp"

#: src/easy_installer/cli.py:670
msgid "how to handle apps whose security sandbox is blocked by this computer: auto (recommended), apparmor (add a system permission), no-sandbox (start without the sandbox) or none (change nothing)"
msgstr "Umgang mit Apps, deren Sicherheits-Sandbox dieser Computer blockiert: auto (empfohlen), apparmor (Systemberechtigung hinzufügen), no-sandbox (ohne Sandbox starten) oder none (nichts ändern)"

#: src/easy_installer/cli.py:674
msgid "let the app unpack itself on every start (needed when FUSE is missing): auto, yes or no"
msgstr "die App sich bei jedem Start selbst entpacken lassen (nötig, wenn FUSE fehlt): auto, yes oder no"

#: src/easy_installer/cli.py:677
msgid "install even if the app is made for a different kind of computer"
msgstr "auch installieren, wenn die App für eine andere Art von Computer gemacht ist"

#: src/easy_installer/cli.py:678
msgid "do not ask before installing"
msgstr "vor dem Installieren nicht nachfragen"

#: src/easy_installer/cli.py:684
msgid "look for new versions of your apps and install them"
msgstr "nach neuen Versionen deiner Apps suchen und sie installieren"

#: src/easy_installer/cli.py:685
msgid "Look for new versions of the installed apps and install them. Without an app ID or --all, it only shows which new versions there are."
msgstr "Sucht nach neuen Versionen der installierten Apps und installiert sie. Ohne App-ID oder --all wird nur angezeigt, welche neuen Versionen es gibt."

#: src/easy_installer/cli.py:687
#, python-brace-format
msgid ""
"Examples:\n"
"  {prog} update             (only look)\n"
"  {prog} update --all       (install every new version)\n"
"  {prog} update freecad     (update one app)"
msgstr ""
"Beispiele:\n"
"  {prog} update             (nur nachsehen)\n"
"  {prog} update --all       (jede neue Version installieren)\n"
"  {prog} update freecad     (eine App aktualisieren)"

#: src/easy_installer/cli.py:693
#, python-brace-format
msgid "the ID of an app to update (see: {command})"
msgstr "die ID einer zu aktualisierenden App (siehe: {command})"

#: src/easy_installer/cli.py:695
msgid "update every app that has a new version"
msgstr "jede App aktualisieren, für die es eine neue Version gibt"

#: src/easy_installer/cli.py:697
msgid "only show which new versions there are, do not install them"
msgstr "nur anzeigen, welche neuen Versionen es gibt, nichts installieren"

#: src/easy_installer/cli.py:700
msgid "do not ask before updating"
msgstr "vor dem Aktualisieren nicht nachfragen"

#: src/easy_installer/cli.py:720
msgid "look for new versions of your apps automatically (yes or no)"
msgstr "automatisch nach neuen Versionen deiner Apps suchen (ja oder nein)"

#: src/easy_installer/cli.py:721
msgid "hours between two automatic checks for new versions"
msgstr "Stunden zwischen zwei automatischen Suchen nach neuen Versionen"

#: src/easy_installer/cli.py:722
msgid "days the replaced version of an app is kept after an update, so you can go back to it (0 = do not keep it)"
msgstr "wie viele Tage die ersetzte Version einer App nach einem Update aufbewahrt wird, damit du zu ihr zurückkehren kannst (0 = nicht aufbewahren)"

#: src/easy_installer/cli.py:731
msgid "show or change the settings"
msgstr "die Einstellungen anzeigen oder ändern"

#: src/easy_installer/cli.py:732
msgid "Show the settings, or change one of them."
msgstr "Zeigt die Einstellungen an oder ändert eine davon."

#: src/easy_installer/cli.py:733
#, python-brace-format
msgid ""
"Settings:\n"
"{keys}\n"
"\n"
"Examples:\n"
"  {prog} settings\n"
"  {prog} settings backup-days 30"
msgstr ""
"Einstellungen:\n"
"{keys}\n"
"\n"
"Beispiele:\n"
"  {prog} settings\n"
"  {prog} settings backup-days 30"

#: src/easy_installer/cli.py:737
msgid "the setting to show or change"
msgstr "die Einstellung, die angezeigt oder geändert werden soll"

#: src/easy_installer/cli.py:738
msgid "the new value"
msgstr "der neue Wert"

#: src/easy_installer/cli.py:795
#, python-brace-format
msgid "The output could not be written: {reason}"
msgstr "Die Ausgabe konnte nicht geschrieben werden: {reason}"

#: src/easy_installer/cli.py:808
msgid "Cancelled."
msgstr "Abgebrochen."

#: src/easy_installer/cli.py:821 src/easy_installer/cli.py:849
#: src/easy_installer/cli.py:859 src/easy_installer/cli.py:1709
#: src/easy_installer/cli.py:2107
#, python-brace-format
msgid "Error: {message}"
msgstr "Fehler: {message}"

#: src/easy_installer/cli.py:821 src/easy_installer/cli.py:2103
msgid "Something unexpected went wrong."
msgstr "Etwas Unerwartetes ist schiefgelaufen."

#: src/easy_installer/cli.py:825
msgid "Run the command again with --verbose to see the technical details."
msgstr "Führe den Befehl mit --verbose erneut aus, um die technischen Details zu sehen."

#: src/easy_installer/cli.py:839 src/easy_installer/core/privileged.py:274
msgid "Authentication was cancelled."
msgstr "Die Authentifizierung wurde abgebrochen."

#: src/easy_installer/cli.py:844
msgid "If you are sure, run the command again with --allow-foreign-arch."
msgstr "Wenn du dir sicher bist, führe den Befehl mit --allow-foreign-arch erneut aus."

#: src/easy_installer/cli.py:854 src/easy_installer/cli.py:2109
msgid "Details:"
msgstr "Details:"

#: src/easy_installer/cli.py:874
#, python-brace-format
msgid "{name} went back to version {version} by itself."
msgstr "{name} ist von selbst zu Version {version} zurückgekehrt."

#: src/easy_installer/cli.py:878
#, python-brace-format
msgid "{name} updated itself to version {version}."
msgstr "{name} hat sich selbst auf Version {version} aktualisiert."

#: src/easy_installer/cli.py:880
#, python-brace-format
msgid "{name} updated itself."
msgstr "{name} hat sich selbst aktualisiert."

#: src/easy_installer/cli.py:882
#, python-brace-format
msgid "{name} (installed for everyone) changed its own app file. To bring its menu entry up to date, run: {command}"
msgstr "{name} (für alle installiert) hat die eigene App-Datei geändert. Um den Menüeintrag auf den neuesten Stand zu bringen, führe aus: {command}"

#: src/easy_installer/cli.py:886
#, python-brace-format
msgid "The app file of {name} now contains a different app. Nothing was changed. To repair it, install {name} again."
msgstr "Die App-Datei von {name} enthält jetzt eine andere App. Es wurde nichts verändert. Um das zu beheben, installiere {name} erneut."

#: src/easy_installer/cli.py:913
msgid "Looking at the installed apps…"
msgstr "Installierte Apps werden angesehen…"

#: src/easy_installer/cli.py:973
msgid "script"
msgstr "Skript"

#: src/easy_installer/cli.py:973
msgid "program"
msgstr "Programm"

#: src/easy_installer/cli.py:1004
#, python-brace-format
msgid "{name} contains several programs that could start it:"
msgstr "{name} enthält mehrere Programme, die die App starten könnten:"

#: src/easy_installer/cli.py:1010
#, python-brace-format
msgid "{kind}, started by the installed version"
msgstr "{kind}, startet die installierte Version"

#: src/easy_installer/cli.py:1012 src/easy_installer/cli.py:1420
#, python-brace-format
msgid "{kind}, recommended"
msgstr "{kind}, empfohlen"

#: src/easy_installer/cli.py:1015
#, python-brace-format
msgid "Which one should start the app? [{first}-{last}, Enter = {default}] "
msgstr "Welches soll die App starten? [{first}-{last}, Eingabe = {default}] "

#: src/easy_installer/cli.py:1029
msgid "--executable can only be used for an app that comes as an archive (.zip, .tar.gz, …)."
msgstr "--executable kann nur für eine App verwendet werden, die als Archiv kommt (.zip, .tar.gz, …)."

#: src/easy_installer/cli.py:1036
#, python-brace-format
msgid "There is no program “{name}” in this archive."
